{
  "schema_version": 1,
  "kind": "heim_pc.critical_user_data_scope_contract",
  "scope": "critical-user-data-docker-volumes",
  "scope_semantics": "whole-root-by-default",
  "root": "/var/lib/docker/volumes",
  "logical_root": "/var/lib/docker/volumes",
  "inventory": {
    "schema": "heim_pc.critical_user_data_inventory.v1",
    "algorithm": "canonical-record-stream-sha256-v1",
    "same_filesystem_only": true,
    "follow_symlinks": false,
    "regular_file_content_sha256": true,
    "directory_mode_bound": true,
    "regular_file_mode_bound": true,
    "symlink_target_bound": true,
    "special_files": "excluded-runtime-only",
    "unreadable_included_path": "fail",
    "changed_during_hash": "fail",
    "uid_gid_bound": true
  },
  "exclusions": {
    "top_level_prefixes": [],
    "roots": [],
    "directory_names_under": [],
    "file_name_prefixes_under": [],
    "file_name_prefix_suffixes_under": []
  },
  "source_consistency": {
    "full_authoritative_inventory_requires_docker_quiesced": true,
    "raw_volume_tree_is_preservation_material_not_active_nixos_layout": true,
    "changed_during_hash": "fail"
  },
  "required_classes": [
    "mattermost-database-and-persistent-app-data",
    "unifi-database-and-configuration",
    "other-docker-volume-state-not-proven-regenerable"
  ],
  "destination_policy": {
    "nixos_storage_domain": "@data",
    "raw_restore_mode": "staged-archive",
    "direct_restore_into_new_docker_volume_store": false,
    "application_level_reconstruction_preferred": true
  },
  "off_host_restore": {
    "backup_must_be_complete_for_scope": true,
    "target_must_be_independent": true,
    "disposable_restore_target_required": true,
    "network_required_for_restore": false,
    "source_and_restored_inventory_sha256_must_match": true
  },
  "does_not_establish": [
    "application-level consistency while Docker writers are running",
    "safe direct import into a new Docker runtime",
    "existence of an off-host backup",
    "sufficient off-host capacity",
    "successful restore",
    "permission to mutate production storage",
    "permission to cross the point of no return"
  ]
}
