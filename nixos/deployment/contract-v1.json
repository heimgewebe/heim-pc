{
  "schema_version": 1,
  "kind": "heim_pc.nixos_managed_deployment_contract",
  "closure": {
    "store_root": "/nix/store",
    "system_name_prefix": "nixos-system-heim-pc-",
    "nix_base32_alphabet": "0123456789abcdfghijklmnpqrsvwxyz",
    "validation_scope": "syntactic immutable Heim-PC system-closure identity; existence and realization remain successor-runtime observations"
  },
  "build": {
    "effect_class": "build",
    "request_kind": "heim_pc.nixos_build_request",
    "request_fields": [
      "schema_version",
      "kind",
      "effect_class",
      "repository",
      "source_revision",
      "control_release_set",
      "nix_inputs",
      "budgets",
      "leases",
      "possible_effects",
      "entrypoint"
    ],
    "required_bindings": [
      "repository",
      "source_revision",
      "control_release_set",
      "nix_inputs",
      "budgets",
      "leases",
      "possible_effects",
      "entrypoint"
    ],
    "canonical_entrypoint": [
      "nix",
      "build",
      ".#nixosConfigurations.heim-pc.config.system.build.toplevel",
      "--no-link",
      "--print-out-paths"
    ],
    "receipt_kind": "heim_pc.nixos_build_receipt",
    "receipt_fields": [
      "schema_version",
      "kind",
      "effect_class",
      "result",
      "repository",
      "source_revision",
      "control_release_set",
      "nix_inputs_sha256",
      "budgets",
      "leases_sha256",
      "possible_effects",
      "effect_scope",
      "system_closure",
      "declared_capabilities",
      "build_request_sha256",
      "activation_authorized"
    ],
    "receipt_requires": [
      "schema_version",
      "kind",
      "effect_class",
      "result",
      "repository",
      "source_revision",
      "control_release_set",
      "nix_inputs_sha256",
      "budgets",
      "leases_sha256",
      "possible_effects",
      "effect_scope",
      "system_closure",
      "declared_capabilities",
      "build_request_sha256",
      "activation_authorized"
    ],
    "request_digest_semantics": "canonical-validated-input-v1",
    "request_digest_excludes_derived_fields": [
      "effect_scope"
    ],
    "activation_authorized": false,
    "receipt_validation_establishes": "exact shape and internal consistency only; provenance/authenticity belongs to the managed-build successor boundary",
    "declared_capabilities_schema": "non-empty canonical JSON object; capability taxonomy is supplied by a separate canonical hardware/facts contract rather than invented here",
    "budget_policy": "warning and hard are non-negative integers with warning strictly below hard"
  },
  "activation": {
    "effect_class": "activation",
    "authority_kind": "heim_pc.nixos_activation_authority",
    "authority_fields": [
      "schema_version",
      "kind",
      "effect_class",
      "mode",
      "source_revision",
      "system_closure",
      "target",
      "build_receipt_sha256",
      "prior_closure",
      "recovery_path",
      "issued_at",
      "expires_at"
    ],
    "plan_kind": "heim_pc.nixos_activation_plan",
    "plan_fields": [
      "schema_version",
      "kind",
      "effect_class",
      "mode",
      "target",
      "source_revision",
      "system_closure",
      "build_receipt_sha256",
      "prior_closure",
      "recovery_path",
      "authority_sha256",
      "executor_authority",
      "source_reevaluation_allowed",
      "broad_root_shell_allowed"
    ],
    "receipt_kind": "heim_pc.nixos_activation_receipt",
    "allowed_modes": [
      "test",
      "next-boot",
      "persistent"
    ],
    "executor_authority": "successor-task-typed-activation-only",
    "max_authority_lifetime_seconds": 7200,
    "boot_critical_persistent_directly_allowed": false,
    "requires_exact_build_receipt": true,
    "requires_exact_system_closure": true,
    "requires_exact_target": true,
    "requires_independent_live_closure_readback": true,
    "source_reevaluation_allowed": false,
    "branch_resolution_allowed": false,
    "lock_resolution_allowed": false,
    "remote_input_resolution_allowed": false,
    "broad_root_shell_allowed": false,
    "runtime_executor_implemented_here": false,
    "runtime_proof_task": "HEIM-PC-NIXOS-MIGRATION-V1-T004",
    "requires_external_authority_sha256": true,
    "self_asserted_review_flag_allowed": false
  },
  "effect_classifier": {
    "unknown_effect": "destructive",
    "destructive_path": "separate-explicit-storage-or-firmware-plan",
    "destructive_effects": [
      "partition-table-mutation",
      "filesystem-create-destroy",
      "luks-container-mutation",
      "luks-metadata-mutation",
      "luks-keyslot-mutation",
      "efi-key-material-mutation",
      "secure-boot-key-material-mutation",
      "firmware-flash"
    ],
    "boot_critical_effects": [
      "kernel",
      "initrd",
      "bootloader",
      "root-unlock-config",
      "early-mount-config",
      "early-driver-module",
      "storage-layout-config",
      "luks-config"
    ],
    "normal_effects": [
      "package-set",
      "desktop-session",
      "user-service",
      "normal-system-service",
      "development-tooling",
      "audio-userspace",
      "network-userspace"
    ],
    "boot_critical_requires_next_boot_path": true
  },
  "rollback": {
    "requires_prior_closure": true,
    "requires_recovery_path": true,
    "source_reevaluation_allowed": false
  },
  "implementation_boundary": {
    "live_activation": false,
    "service_restart": false,
    "runtime_rollback": false,
    "production_storage_mutation": false,
    "efi_mutation": false,
    "secure_boot_mutation": false,
    "firmware_mutation": false,
    "reboot": false
  },
  "execution_context": {
    "build_context_kind": "heim_pc.nixos_build_source_context",
    "build_context_fields": [
      "schema_version",
      "kind",
      "repository",
      "source_revision",
      "build_request_sha256"
    ],
    "build_repository_must_match_observed_repository": true,
    "build_source_revision_must_match_observed_checkout": true,
    "activation_target_must_come_from_reserved_runtime_target": true,
    "current_time_must_come_from_trusted_runtime_clock": true,
    "caller_supplied_values_are_authority": false
  }
}
