# Heim-PC SSH cockpit: OSC52 to the attached terminal, no global clipboard daemon.
set -g mouse on
setw -g mode-keys vi
set -g history-limit 200000
set -s set-clipboard on
# The server executable is used so profile changes cannot break tmux protocol compatibility.
set-hook -g client-attached 'run-shell -b "@setsid@ -f @watcher@ --socket #{q:socket_path} --tmux-bin /proc/#{pid}/exe </dev/null >/dev/null 2>&1"'
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel
bind-key Y run-shell -b "@omnicopy@ '#{pane_id}'"
