+// Receive an actual barrier FD, prove the sender stays blocked, then acknowledge.
+func TestSendMessageAndWait(t *testing.T) {
+	for _, mode := range []string{"ack", "timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "notify")
+			conn, err := net.ListenUnixgram("unixgram", &net.UnixAddr{Name: path, Net: "unixgram"})
+			require.NoError(t, err)
+			defer conn.Close()
+			require.NoError(t, conn.SetReadDeadline(time.Now().Add(3*time.Second)))
+			done := make(chan error, 1)
+			timeout := 2 * time.Second
+			if mode == "timeout" {
+				timeout = 200 * time.Millisecond
+			}
+			go func() { done <- SendMessageAndWait(path, "MAINPID=123\nREADY=1", timeout) }()
+			buf := make([]byte, 4096)
+			oob := make([]byte, unix.CmsgSpace(4))
+			n, oobn, _, _, err := conn.ReadMsgUnix(buf, oob)
+			if err != nil {
+				select {
+				case e := <-done:
+					t.Fatalf("first read: %v; sender returned: %v", err, e)
+				default:
+					t.Fatalf("first read: %v; sender still running", err)
+				}
+			}
+			require.Equal(t, "MAINPID=123\nREADY=1", string(buf[:n]))
+			require.Zero(t, oobn)
+			n, oobn, _, _, err = conn.ReadMsgUnix(buf, oob)
+			if err != nil {
+				select {
+				case e := <-done:
+					t.Fatalf("barrier read: %v; sender returned: %v", err, e)
+				default:
+					t.Fatalf("barrier read: %v; sender still running", err)
+				}
+			}
+			require.Equal(t, "BARRIER=1", string(buf[:n]))
+			msgs, err := unix.ParseSocketControlMessage(oob[:oobn])
+			require.NoError(t, err)
+			require.Len(t, msgs, 1)
+			fds, err := unix.ParseUnixRights(&msgs[0])
+			require.NoError(t, err)
+			require.Len(t, fds, 1)
+			fd := fds[0]
+			defer func() {
+				if fd >= 0 {
+					_ = unix.Close(fd)
+				}
+			}()
+			if mode == "ack" {
+				select {
+				case err := <-done:
+					t.Fatalf("returned before barrier acknowledgment: %v", err)
+				case <-time.After(30 * time.Millisecond):
+				}
+				require.NoError(t, unix.Close(fd))
+				fd = -1
+				select {
+				case err := <-done:
+					require.NoError(t, err)
+				case <-time.After(3 * time.Second):
+					t.Fatal("did not finish after barrier acknowledgment")
+				}
+			} else {
+				select {
+				case err := <-done:
+					require.ErrorIs(t, err, os.ErrDeadlineExceeded)
+				case <-time.After(3 * time.Second):
+					t.Fatal("did not respect timeout")
+				}
+			}
+		})
+	}
+}
+
