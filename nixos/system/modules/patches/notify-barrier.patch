+// SendMessageAndWait sends a notification and waits for the receiver to consume
+// it. A BARRIER message carries a pipe descriptor which the receiver closes
+// after processing previous messages. This is not an application health check.
+func SendMessageAndWait(socketPath, message string, timeout time.Duration) error {
+	if socketPath == "" {
+		socketPath = os.Getenv("NOTIFY_SOCKET")
+		if socketPath == "" {
+			return nil
+		}
+	}
+	deadline := time.Now().Add(timeout)
+	conn, err := net.DialUnix("unixgram", nil, &net.UnixAddr{Name: socketPath, Net: "unixgram"})
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	if err := conn.SetWriteDeadline(deadline); err != nil {
+		return err
+	}
+	readEnd, writeEnd, err := os.Pipe()
+	if err != nil {
+		return err
+	}
+	defer readEnd.Close()
+	defer writeEnd.Close()
+	if err := readEnd.SetReadDeadline(deadline); err != nil {
+		return err
+	}
+	if _, err := conn.Write([]byte(message)); err != nil {
+		return err
+	}
+	// UnixConn.WriteMsgUnix rejects a connected unixgram socket. Send the
+	// descriptor using the existing connection, preserving datagram order
+	// and the net package's write deadline.
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	rights := unix.UnixRights(int(writeEnd.Fd()))
+	var sendErr error
+	if err := raw.Write(func(fd uintptr) bool {
+		for {
+			_, sendErr = unix.SendmsgN(int(fd), []byte(_notifyBarrierMsg), rights, nil, 0)
+			if errors.Is(sendErr, unix.EINTR) {
+				continue
+			}
+			return !errors.Is(sendErr, unix.EAGAIN) && !errors.Is(sendErr, unix.EWOULDBLOCK)
+		}
+	}); err != nil {
+		return err
+	}
+	if sendErr != nil {
+		return sendErr
+	}
+	if err := writeEnd.Close(); err != nil {
+		return err
+	}
+	var buf [1]byte
+	n, err := readEnd.Read(buf[:])
+	if n == 0 && errors.Is(err, io.EOF) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("waiting for notify barrier: %w", err)
+	}
+	return fmt.Errorf("unexpected data on notify barrier")
 }
 
