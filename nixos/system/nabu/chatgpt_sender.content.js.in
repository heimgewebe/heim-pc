"use strict";

// Generated locally with a private per-installation key. Never commit a filled copy.
// Capture the signed URL at document_start, before the application's router may
// remove or change its query string. Never export the prompt or account data.
(async function nabuSignedChatGPTSend() {
  if (location.origin !== "https://chatgpt.com") return;
  const initialPath = location.pathname;
  const params = new URLSearchParams(location.search);
  const names = Array.from(params.keys()).sort().join(",");
  const verifyOnly = names === "nabu_nonce,nabu_sig,nabu_ts,nabu_verify";
  if (!verifyOnly && names !== "nabu_nonce,nabu_sig,nabu_ts,prompt") return;
  // Sending is deliberately restricted to a new chat. A signed verification
  // link for an existing conversation can never execute a send.
  if (verifyOnly ? !/^\/c\/[a-zA-Z0-9-]{8,100}\/?$/.test(location.pathname) :
      location.pathname !== "/") return;

  const prompt = params.get("prompt") || "";
  const expectedDigest = params.get("nabu_verify") || "";
  const tsText = params.get("nabu_ts") || "";
  const nonce = params.get("nabu_nonce") || "";
  const signature = params.get("nabu_sig") || "";
  const ts = Number(tsText);
  const now = Math.floor(Date.now() / 1000);
  // Match Python quote(..., safe=""), including the five extra escaped chars.
  const encodedLength = encodeURIComponent(prompt).replace(/[!'()*]/g, "%00").length;
  if ((verifyOnly ? !/^[a-f0-9]{64}$/.test(expectedDigest) :
      !prompt || encodedLength > 4800) ||
      !/^[0-9]{10}$/.test(tsText) || !Number.isSafeInteger(ts) ||
      ts > now + 15 || now - ts > 180 ||
      !/^[a-f0-9]{24}$/.test(nonce) || !/^[a-f0-9]{64}$/.test(signature)) return;

  const secret = "__NABU_SEND_SECRET_HEX__";
  if (!/^[a-f0-9]{64}$/.test(secret)) return;
  const bytes = hex => new Uint8Array(hex.match(/../g).map(x => parseInt(x, 16)));
  const payload = new TextEncoder().encode(verifyOnly
    ? "nabu-verify-v1\n" + tsText + "\n" + nonce + "\n" + initialPath + "\n" + expectedDigest
    : "nabu-send-v1\n" + tsText + "\n" + nonce + "\n" + prompt
  );
  const key = await crypto.subtle.importKey(
    "raw", bytes(secret), { name: "HMAC", hash: "SHA-256" }, false, ["verify"]
  );
  if (!await crypto.subtle.verify("HMAC", key, bytes(signature), payload)) return;

  let lastStage;
  async function report(stage) {
    if (lastStage === stage) return;
    lastStage = stage;
    try {
      await chrome.runtime.sendMessage({type: "nabu-send-status-v1", nonce, stage});
    } catch {
      // A lost diagnostic must not cause an unconfirmed submission to be retried.
    }
  }

  const visible = el => el && el.getClientRects().length > 0;
  const findVisible = selector => Array.from(document.querySelectorAll(selector)).find(visible);
  const normalize = value => (value || "").replace(/\r\n/g, "\n").trim();
  const composer = () => findVisible('#prompt-textarea,textarea,[contenteditable="true"][role="textbox"],[role="textbox"][contenteditable]');
  const composerMatches = () => {
    const el = composer();
    return el && normalize("value" in el ? el.value : el.innerText) === prompt;
  };
  const accountVisible = () => !!findVisible(
    '[data-testid="profile-button"],[data-testid="account-menu-button"],[data-testid="profile-menu-button"],' +
    'button[aria-label="Open profile menu"],button[aria-label="Profilmenü öffnen"],button[aria-label="Kontomenü öffnen"]'
  );
  const signInVisible = () => !!findVisible(
    '[data-testid="login-button"],[data-testid="signup-button"],' +
    'button[aria-label="Log in"],button[aria-label="Anmelden"]'
  );
  // ChatGPT uses localized accessible names and may change the test ID.
  // Prefer explicit Send semantics; only fall back to a unique submit button
  // in the form that actually contains the exact authorized composer.
  const sendLabels = new Set([
    "send", "send message", "send prompt", "submit prompt",
    "senden", "absenden", "abschicken", "nachricht senden",
    "nachricht absenden", "nachricht abschicken",
    "prompt senden", "prompt absenden", "prompt abschicken"
  ]);
  const labelOf = el => normalize(el.getAttribute("aria-label") ||
    el.getAttribute("title")).toLowerCase();
  const otherAction = el => /voice|dictat|microphone|stop|cancel|speech|sprach|diktier|mikrofon|stopp|abbrechen/i
    .test(labelOf(el) + " " + (el.getAttribute("data-testid") || ""));
  const available = el => visible(el) && !el.disabled &&
    el.getAttribute("aria-disabled") !== "true" && !otherAction(el);
  const explicitlySend = el => sendLabels.has(labelOf(el)) ||
    el.getAttribute("data-testid") === "send-button";
  const sendCandidates = () => {
    const el = composer();
    const form = el?.closest?.("form");
    const explicit = Array.from((form || document).querySelectorAll("button"))
      .filter(explicitlySend);
    if (explicit.length) return explicit;
    // Never click an unknown standalone button or the shared voice/stop control.
    if (!form) return [];
    return Array.from(form.querySelectorAll('button[type="submit"]'))
      .filter(button => !otherAction(button));
  };
  const findSend = () => {
    const candidates = sendCandidates().filter(available);
    return candidates.length === 1 ? candidates[0] : undefined;
  };
  // Only user-message containers are examined, never assistant output.
  // Account or action labels on an outer wrapper must not invalidate the
  // exact outgoing text in a visible child.
  const ownMessageTexts = () => {
    const result = [];
    const roots = Array.from(document.querySelectorAll(
      '[data-message-author-role="user"],[data-turn="user"]'
    )).slice(-12);
    for (const el of roots) {
      if (!visible(el)) continue;
      const nodes = [el, ...Array.from(el.querySelectorAll?.(
        'div,p,span,[data-testid="user-message"]'
      ) || []).slice(0, 120)];
      for (const node of nodes) {
        if (!visible(node)) continue;
        const value = normalize(node.innerText);
        if (value && value.length <= 4800) result.push(value);
      }
    }
    return result;
  };
  const ownMessageVisible = () => ownMessageTexts().includes(prompt);
  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));

  if (verifyOnly) {
    // Recover an ambiguous send receipt without another click. The signed
    // digest and exact conversation path bind this read-only operation.
    for (let i = 0; i < 150; i++) {
      if (location.origin !== "https://chatgpt.com" || location.pathname !== initialPath ||
          Math.floor(Date.now() / 1000) - ts > 180) return;
      if (!signInVisible() && accountVisible()) {
        for (const value of ownMessageTexts()) {
          const digest = Array.from(new Uint8Array(await crypto.subtle.digest(
            "SHA-256", new TextEncoder().encode(value)
          )), x => x.toString(16).padStart(2, "0")).join("");
          if (digest === expectedDigest) {
            await report("message_verified");
            return;
          }
        }
      }
      await wait(200);
    }
    await report("verification_not_found");
    return;
  }

  await report("validated");
  let waiting = "account_unconfirmed";
  // Poll as well as allowing DOM changes: setting a textarea's value does not
  // necessarily trigger a MutationObserver. All waits are bounded.
  for (let i = 0; i < 150; i++) {
    if (location.origin !== "https://chatgpt.com" || location.pathname !== initialPath ||
        Math.floor(Date.now() / 1000) - ts > 180) {
      await report("expired"); return;
    }
    if (signInVisible()) {
      waiting = "login_required";
    } else if (!accountVisible()) {
      waiting = "account_unconfirmed";
    } else if (!composer()) {
      waiting = "composer_missing";
    } else if (!composerMatches()) {
      waiting = "composer_mismatch";
    } else if (!findSend()) {
      const candidates = sendCandidates();
      waiting = candidates.length ? "send_button_unavailable" : "send_button_missing";
    } else {
      if (ownMessageVisible()) { await report("already_present"); return; }
      let grant;
      try {
        // The worker serializes and persists claims across all tabs.
        grant = await chrome.runtime.sendMessage({type: "nabu-signed-send-claim-v1", nonce});
      } catch {
        await report("claim_unconfirmed"); return;
      }
      if (grant?.granted !== true) { await report("claim_denied"); return; }
      // Re-check every UI prerequisite after the asynchronous claim.
      const button = findSend();
      if (location.origin !== "https://chatgpt.com" || location.pathname !== initialPath || signInVisible() ||
          !accountVisible() || !composerMatches() || !button || ownMessageVisible() ||
          Math.floor(Date.now() / 1000) - ts > 180) {
        await report("composer_changed"); return;
      }

      // Do not manipulate the application's router before clicking the button.
      // The durable claim already prevents repeating a possibly sent message.
      button.click();
      await report("click_attempted");
      for (let j = 0; j < 75; j++) {
        if (location.origin !== "https://chatgpt.com") break;
        if (ownMessageVisible()) { await report("message_sent"); return; }
        await wait(200);
      }
      await report("send_unconfirmed");
      return;
    }
    await report(waiting);
    await wait(200);
  }
  await report("timeout_" + waiting);
})();
