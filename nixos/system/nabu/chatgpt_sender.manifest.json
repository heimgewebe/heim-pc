{
  "manifest_version": 3,
  "name": "Nabu ChatGPT Textversand",
  "version": "1.0.0",
  "description": "Sendet ausschließlich frische, lokal signierte Nabu-Aufträge auf chatgpt.com.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
