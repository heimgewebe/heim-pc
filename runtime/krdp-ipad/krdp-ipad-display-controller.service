[Unit]
Description=Restore local screens when iPad native KRDP display disconnects
After=plasma-workspace.target

[Service]
Type=simple
Environment="DISPLAY=:0" "WAYLAND_DISPLAY=wayland-0" "XDG_SESSION_TYPE=wayland" "QT_QPA_PLATFORM=wayland" "XDG_RUNTIME_DIR=/run/user/1000" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
ExecStart=/run/current-system/sw/bin/python3 /home/alex/.local/share/krdpserver/krdp-ipad-display-controller.py
ExecStopPost=/run/current-system/sw/bin/python3 /home/alex/.local/share/krdpserver/krdp-ipad-display-controller.py --restore
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

[Install]
WantedBy=default.target
