+    // output and ensures the stream is deactivated before State::Closed.
+    auto stream = d->videoStream.get();
+    QMetaObject::invokeMethod(stream, [stream] {
+        stream->close();
+    }, Qt::BlockingQueuedConnection);
     setState(State::Closed);
