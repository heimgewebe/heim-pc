+struct TouchInputBridge
+{
+    InputHandler *handler = nullptr;
+    RdpeiServerContext *context = nullptr;
+    UINT32 channelId = UINT32_MAX;
+};
+
+static UINT onTouchReady(RdpeiServerContext *)
+{
+    qCInfo(KRDP) << "RDP touch input ready";
+    return 0;
+}
+
+static UINT onTouchEvent(RdpeiServerContext *ctx, const RDPINPUT_TOUCH_EVENT *event)
+{
+    auto *bridge = static_cast<TouchInputBridge *>(ctx->user_data);
+    if (!bridge || !bridge->handler || !event) {
+        return 0;
+    }
+    for (UINT16 f = 0; f < event->frameCount; ++f) {
+        const auto &frame = event->frames[f];
+        for (UINT16 i = 0; i < frame.contactCount; ++i) {
+            const auto &contact = frame.contacts[i];
+            bridge->handler->touchContact(contact.contactId, contact.x, contact.y, contact.contactFlags);
+        }
+    }
+    return 0;
+}
+
+static BOOL touchChannelAssigned(RdpeiServerContext *ctx, UINT32 id)
+{
+    auto *bridge = static_cast<TouchInputBridge *>(ctx->user_data);
+    if (bridge) {
+        bridge->channelId = id;
+    }
+    return TRUE;
+}
+
+static BOOL touchChannelCreated(void *userdata, UINT32 id, INT32 status)
+{
+    auto *bridge = static_cast<TouchInputBridge *>(userdata);
+    if (!bridge || bridge->channelId != id || !bridge->context) {
+        return TRUE;
+    }
+    if (status >= 0) {
+        const UINT error = rdpei_server_send_sc_ready(bridge->context, RDPINPUT_PROTOCOL_V300, 0);
+        if (error) {
+            qCWarning(KRDP) << "Could not enable RDPEI touch channel:" << error;
+        }
+    }
+    return TRUE;
+}
