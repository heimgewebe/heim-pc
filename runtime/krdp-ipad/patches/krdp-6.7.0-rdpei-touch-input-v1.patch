+
+void InputHandler::touchContact(uint32_t id, int32_t x, int32_t y, uint32_t flags)
+{
+    const QPointF position(x, y);
+    auto motion = [&](Qt::MouseButtons buttons) {
+        Q_EMIT inputEvent(std::make_shared<QMouseEvent>(QEvent::MouseMove, position, QPointF{},
+                                                      Qt::NoButton, buttons, Qt::NoModifier));
+    };
+    if (flags & RDPINPUT_CONTACT_FLAG_DOWN) {
+        if (d->primaryTouch.has_value()) {
+            return; // Leave additional fingers alone; do not corrupt the first drag.
+        }
+        d->primaryTouch = id;
+        motion(Qt::NoButton);
+        Q_EMIT inputEvent(std::make_shared<QMouseEvent>(QEvent::MouseButtonPress, position, QPointF{},
+                                                      Qt::LeftButton, Qt::LeftButton, Qt::NoModifier));
+    } else if (d->primaryTouch == id) {
+        motion(Qt::LeftButton);
+        if (flags & (RDPINPUT_CONTACT_FLAG_UP | RDPINPUT_CONTACT_FLAG_CANCELED)) {
+            Q_EMIT inputEvent(std::make_shared<QMouseEvent>(QEvent::MouseButtonRelease, position, QPointF{},
+                                                          Qt::LeftButton, Qt::NoButton, Qt::NoModifier));
+            d->primaryTouch.reset();
+        }
+    }
 }
 
