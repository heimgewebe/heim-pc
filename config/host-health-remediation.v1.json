{
  "schema_version": 1,
  "kind": "heim_pc_host_health_log_remediation",
  "performance_profile": {
    "set_command": [
      "/usr/bin/system76-power",
      "profile",
      "performance"
    ],
    "query_command": [
      "/usr/bin/system76-power",
      "profile"
    ],
    "expected_query_line": "Power Profile: Performance",
    "allowed_missing_scsi_failure": {
      "required_all": [
        "failed to set scsi host profiles",
        "no such file or directory"
      ],
      "required_any": [
        "link_power_management_policy",
        "link time power management policy"
      ]
    },
    "command_timeout_seconds": 20
  },
  "mce_edac": {
    "lookback_hours": 24,
    "max_journal_entries": 2000,
    "occurrence_gap_seconds": 5,
    "retained_occurrence_ids": 2000,
    "sample_message_limit": 5,
    "sample_message_bytes": 240,
    "state_schema_version": 2,
    "deduplication": "bounded_constituent_overlap_and_boundary_span",
    "constituent_evidence_limit": 2000
  },
  "deployment": {
    "source_binding": "expected_git_commit_tree",
    "exclusive_lock": "/var/lib/heim-pc/host-health/install.lock",
    "receipt": "/var/lib/heim-pc/host-health/install-receipt.v2.json",
    "target_regular_file_owner": "root:root",
    "target_operations": "descriptor_relative_nofollow",
    "transaction": "preflight_stage_fsync_commit_verify_or_rollback",
    "legacy_removals": [
      "/etc/systemd/system/cpu-governor.service.d/10-verified-profile.conf",
      "/usr/local/sbin/heim-pc-set-performance-profile",
      "/etc/systemd/user/fluidsynth.service.d/10-interactive-user.conf",
      "/etc/systemd/user/fluidsynth.service.d/50-heim-pc-gdm-guard.conf",
      "/etc/systemd/journald.conf.d/50-heim-pc-retention.conf",
      "/etc/systemd/journald.conf.d/99-heim-pc-retention.conf"
    ],
    "activation_performed": false
  },
