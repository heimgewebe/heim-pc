# Snapshot Reference
#
# ⚠️ PLACEHOLDER: This file is a template. Real snapshot references
# will be generated when you run local filesystem scanning via
# repolensd or similar tooling.
#
# This file contains a reference to the full filesystem snapshot,
# which should be stored as a GitHub Artifact or Release Asset to keep
# the repository small.

type: artifact
artifact_name: fs-snapshot-latest
workflow_run_id: null
created_at: null
expires_at: null
size_bytes: 0

# To access a real snapshot (once generated):
# 1. Run local scanning: repolensd export-webmaschine --out /path/to/webmaschine
# 2. Upload large snapshot as GitHub Release Asset (recommended) or Artifact
# 3. Update this file with the reference details
#
# Or use the GitHub CLI:
# gh release list
# gh release download <tag> --pattern "fs-snapshot-*.json"

