  "routing": {
    "schema_version": 1,
    "default_strategy": "local-first",
    "default_local_engine": "faster-whisper",
    "local_engines": [
      "faster-whisper",
      "qwen",
      "parakeet"
    ],
    "dual_local_default_secondary": "qwen",
    "dual_local_disagreement_threshold": 0.18,
    "automatic_cloud_escalation": false,
    "cloud_escalation_requires": [
      "--escalate-to-cloud",
      "--allow-metered-cloud"
    ],
    "default_cloud_model": "gpt-4o-transcribe",
    "local_fallback_engine": "qwen",
    "speed_local_engine": "parakeet"
  },
  "cloud_engines": {
    "gpt-4o-transcribe": {
      "provider": "openai",
      "model": "gpt-4o-transcribe",
      "type": "cloud",
      "cost": "metered",
      "endpoint": "https://api.openai.com/v1/audio/transcriptions",
      "runnable": true,
      "requires_explicit_metered_opt_in": true,
      "response_format": "json",
      "features": {
        "language_detection": true,
        "timestamps": false,
        "diarization": false
      }
    },
    "gpt-4o-mini-transcribe": {
      "provider": "openai",
      "model": "gpt-4o-mini-transcribe",
      "type": "cloud",
      "cost": "metered",
      "endpoint": "https://api.openai.com/v1/audio/transcriptions",
      "runnable": true,
      "requires_explicit_metered_opt_in": true,
      "response_format": "json",
      "features": {
        "language_detection": true,
        "timestamps": false,
        "diarization": false
      }
    },
    "gpt-4o-transcribe-diarize": {
      "provider": "openai",
      "model": "gpt-4o-transcribe-diarize",
      "type": "cloud",
      "cost": "metered",
      "endpoint": "https://api.openai.com/v1/audio/transcriptions",
      "runnable": true,
      "requires_explicit_metered_opt_in": true,
      "response_format": "diarized_json",
      "chunking_strategy": "auto",
      "features": {
        "language_detection": false,
        "timestamps": true,
        "diarization": true
      }
    }
  },
  "selection": {
    "schema_version": 1,
    "selected_at": "2026-08-13",
    "decision": "operator-reviewed",
    "quality_default_engine": "faster-whisper",
    "quality_fallback_engine": "qwen",
    "speed_low_vram_engine": "parakeet",
    "basis": "three human-reference samples plus one qualitative long-form sample",
    "human_reference_sample_count": 3,
    "qualitative_long_form_sample_count": 1,
    "winner_on_all_discriminating_reference_samples": "faster-whisper",
    "full_golden_gate_retained_for_future_revalidation": true,
    "automatic_default_change_allowed": false
  }
}
