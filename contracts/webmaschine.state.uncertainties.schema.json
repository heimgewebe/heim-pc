{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.dev/schemas/webmaschine/state/uncertainties/v1.0.json",
  "title": "Webmaschine State Uncertainties",
  "description": "Drift detection and uncertainty tracking",
  "type": "object",
  "required": ["uncertainties", "summary", "metadata"],
  "properties": {
    "uncertainties": {
      "type": "array",
      "description": "List of detected issues",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_count", "by_category", "by_severity"],
      "properties": {
        "total_count": { "type": "integer" },
        "by_category": { "type": "object" },
        "by_severity": { "type": "object" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "last_scan": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
