{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.dev/schemas/webmaschine/state/index/v1.0.json",
  "title": "Webmaschine State Index",
  "description": "KI-Index for quick AI orientation in filesystem world model",
  "type": "object",
  "required": ["machine", "repos", "artifacts", "metadata"],
  "properties": {
    "machine": {
      "type": "object",
      "description": "Machine identification and root configuration",
      "required": ["name", "roots", "hub"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "description": "Machine hostname or identifier"
        },
        "roots": {
          "type": "array",
          "description": "Root directories to scan",
          "items": {
            "type": "string"
          }
        },
        "hub": {
          "type": ["string", "null"],
          "description": "Primary repository directory"
        }
      }
    },
    "hotspots": {
      "type": "array",
      "description": "Important filesystem areas for AI attention",
      "items": {
        "type": "object",
        "required": ["path", "why"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to hotspot"
          },
          "why": {
            "type": "string",
            "description": "Reason for importance (e.g., 'active dev', 'knowledge')"
          }
        }
      }
    },
    "repos": {
      "type": "object",
      "description": "Repository summary statistics",
      "required": ["count", "active_last_7d"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total repository count"
        },
        "active_last_7d": {
          "type": "array",
          "description": "Repository names with commits in last 7 days",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Pointers to large data files (external storage)",
      "required": ["latest_snapshot", "timeline"],
      "properties": {
        "latest_snapshot": {
          "type": "string",
          "description": "Path to snapshot reference file"
        },
        "timeline": {
          "type": "string",
          "description": "Path to timeline JSONL file"
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "Aggregated filesystem metrics for quick overview",
      "required": ["total_files", "total_size_mb", "potentially_stale_files"],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of files scanned"
        },
        "total_size_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "Total storage used in megabytes"
        },
        "potentially_stale_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of files not modified in the last 180 days"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Index metadata and versioning",
      "required": ["version", "last_updated", "schema_version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Index data version (semver)"
        },
        "last_updated": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Schema version (major.minor)"
        },
        "note": {
          "type": "string",
          "description": "Human-readable notes about data status"
        }
      }
    }
  }
}
