{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.dev/schemas/webmaschine/state/drift/v1.0.json",
  "title": "Webmaschine State Drift",
  "description": "Structured timeline of filesystem change events",
  "type": "object",
  "required": ["events", "metadata"],
  "properties": {
    "events": {
      "type": "array",
      "description": "A list of drift events",
      "items": {
        "type": "object",
        "required": ["timestamp", "type", "path", "details"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the event"
          },
          "type": {
            "type": "string",
            "enum": ["created", "modified", "deleted", "moved"],
            "description": "The type of filesystem event"
          },
          "path": {
            "type": "string",
            "description": "The absolute path of the affected file or directory"
          },
          "details": {
            "type": "object",
            "properties": {
              "size_bytes": {
                "type": "integer",
                "description": "File size after the event"
              },
              "new_path": {
                "type": "string",
                "description": "The new path for 'moved' events"
              },
              "checksum": {
                "type": "string",
                "description": "A checksum (e.g., SHA256) of the file content"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "last_updated"],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Schema version (major.minor)"
        },
        "last_updated": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of the last update"
        }
      }
    }
  }
}
