{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.dev/schemas/webmaschine/state/insights/v1.0.json",
  "title": "Webmaschine State Actionable Insights",
  "description": "A list of actionable insights and recommendations generated by analysis of the filesystem state.",
  "type": "object",
  "required": ["insights", "metadata"],
  "properties": {
    "insights": {
      "type": "array",
      "description": "A list of suggestions for filesystem optimization.",
      "items": {
        "type": "object",
        "required": ["type", "path", "priority", "recommendation", "metrics"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "large_file_detected",
              "old_directory_detected",
              "duplicate_candidate_found",
              "uncommitted_repo_detected",
              "temporary_files_found"
            ],
            "description": "The category of the insight."
          },
          "path": {
            "type": "string",
            "description": "The absolute path to the relevant file or directory."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Priority of the insight, where 5 is the highest."
          },
          "recommendation": {
            "type": "string",
            "description": "A human-readable suggested action."
          },
          "metrics": {
            "type": "object",
            "description": "Data points that support the insight.",
            "properties": {
              "size_mb": {
                "type": "number"
              },
              "last_modified": {
                "type": "string",
                "format": "date-time"
              },
              "file_count": {
                "type": "integer"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": []
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "analysis_timestamp"],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "analysis_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
